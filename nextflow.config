/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  nextflow.config
  Global configuration for the pipeline.
  Profiles: local (default), slurm, singularity, docker, test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ─────────────────────────────────────────────────────────────────────────────
// Default parameters  (override via params.yaml or --param value)
// ─────────────────────────────────────────────────────────────────────────────

params {
    // ── Inputs and execution ────────────────────────────────────────────────
    samplesheet     = null
    outdir          = "results"
    run_manifest    = true
    load_modules    = false
    container       = "pipeline-template:1.0.0"
    geo_container   = "bioconductor/bioconductor_docker:RELEASE_3_18"

    // ── Flow control ─────────────────────────────────────────────────────────
    step            = "all"         // all | stage_one | stage_two | stage_three

    // ── Stage 1 parameters ───────────────────────────────────────────────────
    // param_a      = 10
    // param_b      = 0.5

    // ── Stage 2 parameters ───────────────────────────────────────────────────
    // param_c      = "default_value"

    // ── Stage 3 parameters ───────────────────────────────────────────────────
    // param_d      = true

    // ── Resource caps ────────────────────────────────────────────────────────
    max_memory      = "256.GB"
    max_cpus        = 64
    max_time        = "72.h"

    // ── SLURM overrides (optional) ───────────────────────────────────────────
    slurm_account   = null
    slurm_partition = "norm"
}

// ─────────────────────────────────────────────────────────────────────────────
// Process resource labels
// ─────────────────────────────────────────────────────────────────────────────
//
//   Use these in your modules:  label 'process_low'
//   Memory auto-scales on retry (exit 137 = OOM kill).
//

process {
    resourceLimits = [
        cpus: params.max_cpus,
        memory: params.max_memory,
        time: params.max_time
    ]
    beforeScript = params.load_modules?.toString()?.toBoolean()
        ? 'module load R/4.3 python/3.10'
        : ''

    withLabel: process_medium {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_geo {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2
}

// ─────────────────────────────────────────────────────────────────────────────
// Execution profiles
// ─────────────────────────────────────────────────────────────────────────────

profiles {

    // Default: run locally
    local {
        process.executor = 'local'
        executor {
            cpus   = params.max_cpus
            memory = params.max_memory
        }
    }

    standard {
        process.executor = 'local'
    }

    // SLURM HPC cluster
    slurm {
        process.executor = 'slurm'
        process {
            queue = params.slurm_partition ?: 'norm'
            clusterOptions = {
                def acct = params.slurm_account ?: System.getenv('SLURM_ACCOUNT')
                acct ? "--account=${acct}" : ""
            }
        }
        executor {
            queueSize       = 50
            pollInterval    = '30 sec'
            submitRateLimit = '10/1min'
        }
    }

    // Singularity container (combine with slurm: -profile slurm,singularity)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            container = "docker://${params.container}"
            withLabel: process_geo {
                container = "docker://${params.geo_container}"
            }
        }
    }

    // Docker container
    docker {
        docker.enabled       = true
        docker.userEmulation = true
        process {
            container = params.container
            withLabel: process_geo {
                container = params.geo_container
            }
        }
    }

    // Lightweight test profile (for CI or quick checks)
    test {
        params {
            max_memory = "16.GB"
            max_cpus   = 4
            max_time   = "1.h"
        }
        process {
            withLabel: process_low {
                cpus = 1
                memory = '2 GB'
                time = '1 h'
            }
            withLabel: process_geo {
                cpus = 1
                memory = '2 GB'
                time = '1 h'
            }
            withLabel: process_medium {
                cpus = 2
                memory = '4 GB'
                time = '2 h'
            }
            withLabel: process_high {
                cpus = 2
                memory = '6 GB'
                time = '2 h'
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Reporting & tracing
// ─────────────────────────────────────────────────────────────────────────────

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.tsv"
    overwrite = true
    fields    = 'task_id,hash,native_id,name,status,exit,realtime,cpus,%cpu,memory,%mem,rss,read_bytes,write_bytes,container,attempt'
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.dot"
    overwrite = true
}
process.shell = ['/bin/bash', '-euo', 'pipefail']
