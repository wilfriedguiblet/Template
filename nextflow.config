/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  nextflow.config
  Global configuration for the pipeline.
  Profiles: local (default), slurm, singularity, docker, test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ─────────────────────────────────────────────────────────────────────────────
// Default parameters  (override via params.yaml or --param value)
// ─────────────────────────────────────────────────────────────────────────────

params {
    // ── Required inputs ──────────────────────────────────────────────────────
    expression      = null          // Count matrix TSV/CSV (genes × samples)
    sampleinfo      = null          // Sample metadata CSV (Sample_ID, AGE, ...)
    prefix          = "study"       // Filename prefix for all outputs
    outdir          = "results"     // Root output directory

    // ── Flow control ─────────────────────────────────────────────────────────
    step            = "all"         // all | stage_one | stage_two | stage_three

    // ── Stage 1 parameters ───────────────────────────────────────────────────
    // param_a      = 10
    // param_b      = 0.5

    // ── Stage 2 parameters ───────────────────────────────────────────────────
    // param_c      = "default_value"

    // ── Stage 3 parameters ───────────────────────────────────────────────────
    // param_d      = true

    // ── Resource caps ────────────────────────────────────────────────────────
    max_memory      = "256.GB"
    max_cpus        = 64
    max_time        = "72.h"

    // ── SLURM overrides (optional) ───────────────────────────────────────────
    slurm_account   = null
    slurm_partition = "norm"
}

// ─────────────────────────────────────────────────────────────────────────────
// Process resource labels
// ─────────────────────────────────────────────────────────────────────────────
//
//   Use these in your modules:  label 'process_low'
//   Memory auto-scales on retry (exit 137 = OOM kill).
//

process {
    // Uncomment if your cluster requires a module load before Python:
    // beforeScript = 'module load python'

    withLabel: process_high {
        cpus   = { check_max(params.max_cpus,          'cpus')   }
        memory = { check_max(64.GB * task.attempt,      'memory') }
        time   = { check_max(24.h  * task.attempt,      'time')   }
    }
    withLabel: process_medium {
        cpus   = { check_max(8,                         'cpus')   }
        memory = { check_max(32.GB * task.attempt,      'memory') }
        time   = { check_max(8.h   * task.attempt,      'time')   }
    }
    withLabel: process_low {
        cpus   = { check_max(2,                         'cpus')   }
        memory = { check_max(8.GB  * task.attempt,      'memory') }
        time   = { check_max(2.h   * task.attempt,      'time')   }
    }

    errorStrategy = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// ─────────────────────────────────────────────────────────────────────────────
// Execution profiles
// ─────────────────────────────────────────────────────────────────────────────

profiles {

    // Default: run locally
    local {
        process.executor = 'local'
        executor {
            cpus   = params.max_cpus
            memory = params.max_memory
        }
    }

    // SLURM HPC cluster
    slurm {
        process.executor = 'slurm'
        process {
            queue = params.slurm_partition ?: 'norm'
            clusterOptions = {
                def acct = params.slurm_account ?: System.getenv('SLURM_ACCOUNT')
                acct ? "--account=${acct}" : ""
            }
        }
        executor {
            queueSize       = 50
            pollInterval    = '30 sec'
            submitRateLimit = '10/1min'
        }
    }

    // Singularity container (combine with slurm: -profile slurm,singularity)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            container = params.containsKey('container') ? params.container
                        : "docker://python:3.10-slim"
        }
    }

    // Docker container
    docker {
        docker.enabled       = true
        docker.userEmulation = true
        process {
            container = params.containsKey('container') ? params.container
                        : "python:3.10-slim"
        }
    }

    // Lightweight test profile (for CI or quick checks)
    test {
        params {
            max_memory = "16.GB"
            max_cpus   = 4
            max_time   = "1.h"
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Reporting & tracing
// ─────────────────────────────────────────────────────────────────────────────

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.tsv"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,cpus,%cpu,memory,%mem,rss,vmem'
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg"
    overwrite = true
}

// ─────────────────────────────────────────────────────────────────────────────
// Helper: enforce max resource caps
// ─────────────────────────────────────────────────────────────────────────────

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
}
