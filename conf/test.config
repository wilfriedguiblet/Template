profiles {
    test {
        params {
            max_memory = '16 GB'
            max_cpus = 4
            max_time = '1 h'
        }
        process {
            withLabel: process_low {
                cpus = 1
                memory = '2 GB'
                time = '1 h'
            }
            withLabel: process_medium {
                cpus = 2
                memory = '4 GB'
                time = '2 h'
            }
        }
    }
}