profiles {
    slurm {
        process.executor = 'slurm'
        process {
            queue = params.slurm_partition ?: 'norm'
            clusterOptions = {
                def account = params.slurm_account ?: System.getenv('SLURM_ACCOUNT')
                account ? "--account=${account}" : ''
            }
        }
        executor {
            queueSize = 50
            pollInterval = '30 sec'
            submitRateLimit = '10/1min'
        }
    }
}